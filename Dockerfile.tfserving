FROM tensorflow/serving:2.14.1

# Install tools for downloading models
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    unzip \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Build argument for model download URL
# Set this in Render: Settings → Build & Deploy → Build Arguments
ARG MODEL_DOWNLOAD_URL=""

# Download models if URL is provided
# Use POSIX-compliant shell syntax (not bash-specific [[ ]])
RUN if [ -n "$MODEL_DOWNLOAD_URL" ]; then \
    echo "Downloading models from: $MODEL_DOWNLOAD_URL" && \
    mkdir -p /models/deepfake && \
    case "$MODEL_DOWNLOAD_URL" in \
        *.zip) \
            echo "Downloading zip file..." && \
            wget -q -O /tmp/models.zip "$MODEL_DOWNLOAD_URL" || curl -L -o /tmp/models.zip "$MODEL_DOWNLOAD_URL" && \
            echo "Extracting models (handling Windows paths)..." && \
            cd /tmp && \
            unzip -q -o models.zip 2>&1 | grep -v "backslashes" || true && \
            cd / && \
            if [ -d "/tmp/deepfake/1" ]; then \
                echo "Found /tmp/deepfake/1, copying to /models/deepfake/1..." && \
                mkdir -p /models/deepfake/1 && \
                cp -r /tmp/deepfake/1/* /models/deepfake/1/ 2>/dev/null || true; \
            elif [ -d "/tmp/deepfake" ]; then \
                echo "Found /tmp/deepfake, copying to /models/deepfake..." && \
                cp -r /tmp/deepfake/* /models/deepfake/ 2>/dev/null || true; \
            elif [ -d "/tmp/models/deepfake/1" ]; then \
                echo "Found /tmp/models/deepfake/1, copying to /models/deepfake/1..." && \
                mkdir -p /models/deepfake/1 && \
                cp -r /tmp/models/deepfake/1/* /models/deepfake/1/ 2>/dev/null || true; \
            elif [ -d "/tmp/models/deepfake" ]; then \
                echo "Found /tmp/models/deepfake, copying to /models/deepfake..." && \
                cp -r /tmp/models/deepfake/* /models/deepfake/ 2>/dev/null || true; \
            else \
                echo "Searching for saved_model.pb to locate model directory..." && \
                MODEL_FILE=$(find /tmp -name "saved_model.pb" -type f 2>/dev/null | head -1) && \
                if [ -n "$MODEL_FILE" ]; then \
                    MODEL_DIR=$(dirname "$MODEL_FILE") && \
                    echo "Found model directory at: $MODEL_DIR" && \
                    if [ -d "$MODEL_DIR" ]; then \
                        cp -r "$MODEL_DIR"/* /models/deepfake/ 2>/dev/null || true; \
                    fi; \
                else \
                    echo "Listing /tmp contents to debug..." && \
                    find /tmp -type d -maxdepth 3 2>/dev/null | head -15 && \
                    find /tmp -type f -name "*.pb" -o -name "*.index" 2>/dev/null | head -10; \
                fi; \
            fi && \
            rm -rf /tmp/models.zip /tmp/deepfake /tmp/models 2>/dev/null || true; \
            ;; \
        *.tar.gz|*.tgz) \
            echo "Downloading tar.gz file..." && \
            wget -q -O /tmp/models.tar.gz "$MODEL_DOWNLOAD_URL" || curl -L -o /tmp/models.tar.gz "$MODEL_DOWNLOAD_URL" && \
            echo "Extracting models..." && \
            tar -xzf /tmp/models.tar.gz -C /tmp && \
            if [ -d "/tmp/deepfake" ]; then \
                mv /tmp/deepfake/* /models/deepfake/; \
            elif [ -d "/tmp/models/deepfake" ]; then \
                mv /tmp/models/deepfake/* /models/deepfake/; \
            else \
                MODEL_DIR=$(find /tmp -name "saved_model.pb" -type f | head -1 | xargs dirname) && \
                if [ -n "$MODEL_DIR" ]; then \
                    cp -r "$MODEL_DIR"/* /models/deepfake/ 2>/dev/null || true; \
                fi; \
            fi && \
            rm -rf /tmp/models.tar.gz /tmp/deepfake /tmp/models; \
            ;; \
        *) \
            echo "Error: Unsupported file format. Use .zip or .tar.gz"; \
            exit 1; \
            ;; \
    esac && \
    if [ -d "/models/deepfake/1" ] || [ -f "/models/deepfake/1/saved_model.pb" ]; then \
        echo "Models downloaded successfully!" && ls -la /models/deepfake; \
    else \
        echo "Warning: Models may not be in expected structure." && find /models/deepfake -type f | head -10; \
    fi; \
    else \
    echo "MODEL_DOWNLOAD_URL not set. Models must be in build context or provided via URL."; \
    fi

# Try to copy models from build context (if they exist in repo)
# Note: This will fail if models don't exist, which is expected if using download method
# Uncomment the line below if models are in your repository:
# COPY models/deepfake /models/deepfake

# Set environment variables
ENV MODEL_NAME=deepfake
ENV MODEL_BASE_PATH=/models

# Configure TensorFlow Serving to bind to all interfaces (required for Render)
# This ensures Render can reach the service for health checks
ENV PORT=8501

# Expose TensorFlow Serving port
EXPOSE 8501

# Override command to bind to 0.0.0.0 instead of localhost
# gRPC on 8500, HTTP/REST on 8501 (different ports required)
# This is required for Render to access the service
CMD ["tensorflow_model_server", "--port=8500", "--rest_api_port=8501", "--model_name=deepfake", "--model_base_path=/models/deepfake", "--rest_api_bind_ip=0.0.0.0"]
